# Application
APP_NAME=HyperVision
APP_ENV=production
APP_SECRET_KEY=change-me-to-a-secure-random-256-bit-key
APP_DEBUG=false
APP_PORT=8000

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://hypervision:password@localhost:5432/hypervision

# Redis Cache
REDIS_URL=redis://localhost:6379/0
REDIS_TTL_SECONDS=30
REDIS_VM_POLL_INTERVAL=15

# JWT
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Hyper-V Hosts (comma-separated, or use the API to register)
HYPERV_HOSTS=host1.corp.local,host2.corp.local

# WinRM / PowerShell remoting credentials (service account)
HYPERV_USERNAME=DOMAIN\\svc-hypervision
HYPERV_PASSWORD=change-me

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,https://hypervision.corp.local

# Admin bootstrap
BOOTSTRAP_ADMIN_EMAIL=indrayan@corp.local
BOOTSTRAP_ADMIN_PASSWORD=Indrayan@123pswd
BOOTSTRAP_ADMIN_NAME=Indrayan
